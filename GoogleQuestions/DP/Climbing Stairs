class Solution {
    public int climbStairs(int n) {
        if (n <= 2) return n;          // handle n=1, n=2 directly

        int[] dp = new int[n + 1];     // dp[i] = ways to reach step i
        dp[1] = 1;                     // 1 way to reach step 1
        dp[2] = 2;                     // 2 ways to reach step 2

        for (int i = 3; i <= n; i++) {
            dp[i] = dp[i - 1] + dp[i - 2];
        }

        return dp[n];
    }
}
