public String longestPalindrome(String s) {
    if (s == null || s.length() < 1) return "";

    int start = 0, end = 0;   // bounds of the best palindrome found

    for (int i = 0; i < s.length(); i++) {
        int len1 = expand(s, i, i);       // odd-length center (single char)
        int len2 = expand(s, i, i + 1);   // even-length center (between chars)
        int len = Math.max(len1, len2);

        if (len > end - start + 1) {       // found a longer one → update bounds
            start = i - (len - 1) / 2;
            end = i + len / 2;
        }
    }

    return s.substring(start, end + 1);
}

// expand outward while characters match, return the palindrome's length
private int expand(String s, int left, int right) {
    while (left >= 0 && right < s.length() && s.charAt(left) == s.charAt(right)) {
        left--;
        right++;
    }
    return right - left - 1;   // length of the palindrome found
}
