class Solution {
    public int rob(int[] nums) {
        int n = nums.length;
        if (n == 0) return 0;
        if (n == 1) return nums[0];          // single house, no circle issue

        // case 1: houses 0..n-2   (exclude last)
        // case 2: houses 1..n-1   (exclude first)
        return Math.max(
            robLine(nums, 0, n - 2),
            robLine(nums, 1, n - 1)
        );
    }

    // House Robber I on a subrange [start, end]
    private int robLine(int[] nums, int start, int end) {
        int prev = 0, curr = 0;
        for (int i = start; i <= end; i++) {
            int temp = Math.max(curr, prev + nums[i]);
            prev = curr;
            curr = temp;
        }
        return curr;
    }
}

// or with dp array
class Solution {
    public int rob(int[] nums) {
        int n = nums.length;
        if (n == 0) return 0;
        if (n == 1) return nums[0];

        // circular → two linear cases, take the max
        return Math.max(
            robLine(nums, 0, n - 2),   // exclude last house
            robLine(nums, 1, n - 1)    // exclude first house
        );
    }

    // House Robber I on subrange [start, end], using a dp array
    private int robLine(int[] nums, int start, int end) {
        int len = end - start + 1;      // number of houses in this range
        if (len == 0) return 0;
        if (len == 1) return nums[start];

        int[] dp = new int[len];
        dp[0] = nums[start];                              // first house in range
        dp[1] = Math.max(nums[start], nums[start + 1]);   // richer of first two

        for (int i = 2; i < len; i++) {
            // nums index is offset by `start`
            dp[i] = Math.max(dp[i - 1], dp[i - 2] + nums[start + i]);
        }

        return dp[len - 1];
    }
}
