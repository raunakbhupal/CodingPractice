public int[][] merge(int[][] intervals) {
    Arrays.sort(intervals, (a, b) -> a[0] - b[0]);   // sort by start
    List<int[]> result = new ArrayList<>();

    for (int[] interval : intervals) {
        int start = interval[0];
        int end = interval[1];

        if (result.isEmpty()) {
            result.add(new int[]{start, end});       // first one, just add
            continue;
        }

        int[] last = result.get(result.size() - 1);  // the last interval added

        if (last[1] < start) {
            // last interval ends BEFORE this one starts → no overlap → add fresh
            result.add(new int[]{start, end});
        } else {
            // they overlap → extend last interval's end to cover this one
            last[1] = Math.max(last[1], end);
        }
    }

    return result.toArray(new int[result.size()][]);
}
